# Build the distributable static bundle into ./dist/ and mirror into internal/webui/dist/
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

ensure_node_deps

rm -rf dist
mkdir -p dist

# Execute Vite build
npx --no-install vite build

# The Go embed target lives in internal/webui/dist/
rm -rf internal/webui/dist
mkdir -p internal/webui/dist

# Always recreate the gitkeep
cat > internal/webui/dist/.gitkeep <<'EOF'
# Populated by dev/tools/build. See internal/webui/webui.go for the embed.
EOF

if [[ -d dist ]] && [[ -n "$(ls -A dist 2>/dev/null)" ]]; then
  cp -R dist/. internal/webui/dist/
  echo "▸ built dist/ ($(find dist -type f | wc -l | tr -d ' ') files)"
  echo "▸ mirrored into internal/webui/dist/ for go:embed"
fi
