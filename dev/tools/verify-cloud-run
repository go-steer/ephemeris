# Post-deployment end-to-end verification test for Cloud Run or local Ephemeris server.
# Verifies HTTP /healthz, SPA asset serving (/), WebSocket topology stream (/ws),
# and live AI incident triage ArrowJS UI compilation.
#
# Usage:
#   dev/tools/verify-cloud-run --url https://ephemeris-demo-xxx.run.app
#   dev/tools/verify-cloud-run --url http://localhost:8080

set -euo pipefail
. "$(dirname "$0")/common.sh"

cd "$(repo_root)"

TARGET_URL="http://localhost:8080"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --url)
      TARGET_URL="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: dev/tools/verify-cloud-run [--url <base-url>]"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 2
      ;;
  esac
done

go run ./cmd/verify -url "${TARGET_URL}"
