# Deploy Ephemeris interactive demo to Google Cloud Run.
# Usage:
#   dev/tools/deploy-cloud-run [--project <project-id>] [--region <region>] [--service <name>]

set -euo pipefail
. "$(dirname "$0")/common.sh"

cd "$(repo_root)"

PROJECT_ID="${GOOGLE_CLOUD_PROJECT:-$(gcloud config get-value project 2>/dev/null || true)}"
REGION="${CLOUD_RUN_REGION:-us-central1}"
SERVICE_NAME="${CLOUD_RUN_SERVICE:-ephemeris-demo}"
MODE="${EPHEMERIS_MODE:-mock}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --project)
      PROJECT_ID="$2"
      shift 2
      ;;
    --region)
      REGION="$2"
      shift 2
      ;;
    --service)
      SERVICE_NAME="$2"
      shift 2
      ;;
    --mode)
      MODE="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: dev/tools/deploy-cloud-run [--project <id>] [--region <region>] [--service <name>] [--mode mock|live]"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 2
      ;;
  esac
done

if [[ -z "$PROJECT_ID" ]]; then
  echo "Error: GCP Project ID not set. Pass --project <id> or set GOOGLE_CLOUD_PROJECT." >&2
  exit 1
fi

step "Deploying ${SERVICE_NAME} to Cloud Run [project=${PROJECT_ID}, region=${REGION}, mode=${MODE}]"

gcloud run deploy "${SERVICE_NAME}" \
  --source . \
  --project "${PROJECT_ID}" \
  --region "${REGION}" \
  --allow-unauthenticated \
  --session-affinity \
  --port 8080 \
  --set-env-vars "EPHEMERIS_MODE=${MODE}"

SERVICE_URL="$(gcloud run services describe "${SERVICE_NAME}" \
  --project "${PROJECT_ID}" \
  --region "${REGION}" \
  --format='value(status.url)')"

ok "Deployment complete: ${SERVICE_URL}"

if [[ -n "${SERVICE_URL}" ]]; then
  step "Running post-deployment E2E verification against ${SERVICE_URL}"
  dev/tools/verify-cloud-run --url "${SERVICE_URL}"
fi
