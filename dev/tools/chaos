# Standalone Live GKE Chaos Simulator CLI.
# Executes outside the main ephemeris module in dev/chaos/ against real GKE clusters
# within the isolated 'ephemeris-chaos' namespace.
set -euo pipefail
. "$(dirname "$0")/common.sh"

ROOT="$(repo_root)"
BIN="${ROOT}/bin/ephemeris-chaos"
mkdir -p "${ROOT}/bin"

if [[ ! -x "${BIN}" || "${ROOT}/dev/chaos/main.go" -nt "${BIN}" ]]; then
  (cd "${ROOT}/dev/chaos" && go build -o "${BIN}" .)
fi

exec "${BIN}" "$@"
