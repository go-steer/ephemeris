# Launch local development environment: Go backend daemon + Vite HMR.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

ensure_node_deps

# Build Go server
go build -o bin/ephemeris ./cmd/ephemeris

cleanup() {
  echo "▸ Shutting down dev servers..."
  kill $(jobs -p) 2>/dev/null || true
}
trap cleanup EXIT INT TERM

echo "▸ Starting Go backend on :8080..."
./bin/ephemeris -port=8080 -mode=mock -web-dir=web &

echo "▸ Starting Vite dev server on :5173..."
npx --no-install vite &

wait
